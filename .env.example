# Copie para .env e ajuste. Todas as variaveis sao opcionais (valores abaixo sao os padroes).

# --- Caminhos ---
JAIRO_DIR=C:\09projec
BRAVE_PATH=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# --- Ativacao e voz ---
JAIRO_EXIGIR_WAKE=true
JAIRO_WAKE_ALIASES=jairo,jairó,jairu,jayro
JAIRO_TTS=auto                 # auto | pyttsx3 | powershell
JAIRO_SILENCIOSO=false         # true: confirmacoes viram bipes

# --- Escuta (latencia e sensibilidade) ---
JAIRO_PAUSE=0.8                # silencio (s) que encerra a frase
JAIRO_PHRASE_LIMIT=6           # duracao maxima de uma frase (s)
JAIRO_CALIBRACAO=1.5           # duracao da calibracao do microfone (s)
JAIRO_ENERGY_MIN=120           # limite minimo de energia (RMS int16)
JAIRO_ENERGY_MAX=900
JAIRO_ENERGY=0                 # > 0: ignora a calibracao (use --testar-mic para medir)
JAIRO_GANHO_MAX=4.0            # ganho automatico para voz baixa; 1.0 desativa
JAIRO_ALVO_RMS=2500

# --- WhatsApp ---
JAIRO_DEBUG=false              # true: janela do Brave visivel
PAGE_LOAD_TIMEOUT=30
ELEMENT_TIMEOUT=20
AUTO_RESPONDER_INTERVAL=45     # segundos entre varreduras do auto-responder
MIN_SEND_INTERVAL=3.0          # intervalo minimo entre envios (s)
WPP_QUEUE_SIZE=50
JAIRO_MAX_CHATS_LEITURA=5      # conversas lidas em voz alta por "ler mensagens"
